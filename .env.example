# ============================================================================
# BRAHMA ALARM configuration
# Copy this file to .env and edit. Never commit .env.
#
# Default: PAPER trading with real Dhan market data and simulated fills.
# Set LIVE_TRADING_ENABLED=true (or use the dashboard "Go live" button) only
# after verifying paper behaviour end to end.
# ============================================================================

# ---------------------------------------------------------------- credentials
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token

# ------------------------------------------------------------------- modes
# PAPER = real Dhan data, local simulated fills (no orders sent).
# LIVE  = real Dhan orders. LIVE_TRADING_ENABLED=true is required.
DATA_PROVIDER=dhan
BROKER=dhan
LIVE_TRADING_ENABLED=false
ENABLE_ENGINE=true
IGNORE_MARKET_HOURS=false

# ------------------------------------------------------------------ instrument
UNDERLYING_SYMBOL=BANKNIFTY
# Leave blank to resolve automatically from the Dhan instrument master.
UNDERLYING_SECURITY_ID=
OPTION_SECURITY_ID=
OPTION_SIDE=CE
OPTION_EXPIRY=
STRIKE_MODE=ATM
# 0 = auto-resolve lot size from the master.
OPTION_LOT_SIZE=0
NUMBER_OF_LOTS=1
MAX_LOTS=1

# ------------------------------------------------------------------------ data
TIMEFRAME=1m
LOOKBACK_DAYS=5
MAX_CANDLE_AGE_SEC=180
CHECK_INTERVAL=5

# -------------------------------------------------------------------- strategy
LENGTH=22
GAIN=0.7
USE_KALMAN=true
USE_TREND_FILTER=false
TREND_EMA=50
MIN_BARS_BETWEEN_SIGNALS=0

# ------------------------------------------------------------------------ risk
MAX_DAILY_LOSS=1000
MAX_TRADE_LOSS=500
STOP_LOSS_PERCENT=0.20
MAX_TRADES_PER_DAY=3
MAX_HOLDING_MINUTES=0
COOLDOWN_AFTER_LOSS_MIN=0

# --------------------------------------------------------------------- session
TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
SQUARE_OFF_TIME=15:15
NO_ENTRY_AFTER=14:45
MARKET_HOLIDAYS=
IGNORE_MARKET_HOURS=false

# ------------------------------------------------------------------- execution
PRODUCT_TYPE=INTRADAY
ORDER_TYPE=MARKET
USE_BROKER_SL=false
BROKER_SL_PERCENT=0.15
ORDER_CONFIRM_TIMEOUT_SEC=10

# ------------------------------------------------------------------- dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ----------------------------------------------------------------- paper fills
PAPER_STARTING_CASH=1000000
PAPER_SLIPPAGE_BPS=5

# ------------------------------------------------------------------------ misc
LOG_LEVEL=INFO
